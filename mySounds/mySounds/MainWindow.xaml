<Window x:Class="mySounds.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:mySounds"
        mc:Ignorable="d"
        Title="MySounds, Made by: Daniel" Height="450" Width="800" Background="SeaGreen">
    <Grid>
        <Button x:Name="btnPrev" HorizontalAlignment="Left" Margin="30,130,0,0" VerticalAlignment="Top" Height="70" Width="103" Click="btnPrev_Click">
            <Button.Background>
                <ImageBrush ImageSource="/obraz3.png"/>
            </Button.Background>
        </Button>
        <Button x:Name="btnNext" HorizontalAlignment="Left" Margin="662,130,0,0" VerticalAlignment="Top" Height="70" Width="103" Click="btnNext_Click">
            <Button.Background>
                <ImageBrush ImageSource="/obraz2.png"/>
            </Button.Background>
        </Button>
        <Image HorizontalAlignment="Left" Height="166" Margin="182,51,0,0" VerticalAlignment="Top" Width="178" Source="/obraz.png"/>
        <Label x:Name="lblArtist" Content="artist" FontSize="50" HorizontalAlignment="Left" Margin="368,27,0,0" VerticalAlignment="Top" Height="73" Width="422" Foreground="White"/>
        <Label x:Name="lblTitle" Content="title" FontStyle="Italic" FontSize="30" HorizontalAlignment="Left" Margin="368,97,0,0" VerticalAlignment="Top" Width="274" Foreground="White"/>
        <Label x:Name="lblCount" Content="count" FontSize="20" HorizontalAlignment="Left" Margin="368,152,0,0" VerticalAlignment="Top" Width="94" Foreground="#61D918"/>
        <Label x:Name="lblYear" Content="year" FontSize="20" HorizontalAlignment="Left" Margin="480,152,0,0" VerticalAlignment="Top" Width="81" Foreground="#61D918"/>
        <Label x:Name="lblDownloads" Content="downloads" FontSize="20" HorizontalAlignment="Left" Margin="182,243,0,0" VerticalAlignment="Top" Width="95" Foreground="#61D918"/>
        <Button x:Name="btnDownload" Content="Download" HorizontalAlignment="Left" Margin="292,243,0,0" VerticalAlignment="Top" Height="37" Width="108" Background="#FF61D918" FontWeight="Bold" FontSize="20" Click="btnDownload_Click"/>
    </Grid>
</Window>