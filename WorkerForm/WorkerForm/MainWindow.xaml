<Window x:Class="WorkerForm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorkerForm"
        mc:Ignorable="d"
        Title="Add employee 12345678911" Height="450" Width="800" Background="LightSteelBlue">
    <Grid>
        <GroupBox Header="Employee details" Margin="60,90,440,127">
            <Grid>
                <Label Content="First Name" HorizontalAlignment="Left" Margin="30,20,0,0" VerticalAlignment="Top"/>
                <Label Content="Last Name" HorizontalAlignment="Left" Margin="30,60,0,0" VerticalAlignment="Top"/>
                <Label Content="Position" HorizontalAlignment="Left" Margin="30,100,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="firstNameTextBox" HorizontalAlignment="Left" Margin="144,23,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="20"/>
                <TextBox x:Name="lastNameTextBox" HorizontalAlignment="Left" Margin="144,64,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
                <ComboBox x:Name="positionComboBox" HorizontalAlignment="Left" Margin="144,102,0,0" VerticalAlignment="Top" Width="120">
                    <ComboBoxItem Content="Manager"/>
                    <ComboBoxItem Content="Senior developer"/>
                    <ComboBoxItem Content="Junior developer"/>
                    <ComboBoxItem Content="Tester"/>
                </ComboBox>
            </Grid>
        </GroupBox>
        <GroupBox Header="Password generation" Margin="442,90,58,127">
            <Grid>
                <Label Content="How many characters?" HorizontalAlignment="Left" Margin="30,20,0,0" VerticalAlignment="Top"/>
                <TextBox x:Name="charCountTextBox" HorizontalAlignment="Left" Margin="144,24,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
                <CheckBox x:Name="lowerUpperCheckBox" Content="Lower and uppercase letters" HorizontalAlignment="Left" Margin="30,51,0,0" VerticalAlignment="Top" IsChecked="True"/>
                <CheckBox x:Name="digitsCheckBox" Content="Digits" HorizontalAlignment="Left" Margin="30,82,0,0" VerticalAlignment="Top"/>
                <CheckBox x:Name="specialCheckBox" Content="Special characters" HorizontalAlignment="Left" Margin="30,115,0,0" VerticalAlignment="Top"/>
                <Button Content="Generate password" HorizontalAlignment="Center" Margin="0,146,0,0" VerticalAlignment="Top" Background="SteelBlue" Foreground="White" Click="btnGenerate_Click"/>
            </Grid>
        </GroupBox>
        <Button Content="Confirm" HorizontalAlignment="Center" Margin="0,351,0,0" VerticalAlignment="Top" Width="318" Background="SteelBlue" Foreground="White" Click="btnConfirm_Click"/>
    </Grid>
</Window>