<Window x:Class="cezar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cezar"
        mc:Ignorable="d"
        Title="Encryption. Made by Daniel" Height="450" Width="800" Background="CadetBlue">
    <Grid>
        <Label Content="Enter key value" HorizontalAlignment="Left" Margin="10,20,0,0" VerticalAlignment="Top" Foreground="AntiqueWhite"/>
        <TextBox x:Name="keyTBox" HorizontalAlignment="Left" Margin="110,80,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="52"/>
        <Label Foreground="AntiqueWhite" Content="Enter text" HorizontalAlignment="Left" Margin="10,123,0,0" VerticalAlignment="Top" Width="72"/>
        <TextBox x:Name="normalTextTBox" HorizontalAlignment="Left" Margin="18,178,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="277" Height="231"/>
        <Button x:Name="btnEncrypt" Background="LightBlue" Content="Encrypt" HorizontalAlignment="Center" Margin="0,240,0,0" VerticalAlignment="Top" Height="25" Width="58" Click="btnEncrypt_Click"/>
        <TextBlock x:Name="encryptedTextTBlock" Foreground="AliceBlue"  HorizontalAlignment="Left" Margin="497,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Height="245" Width="252"/>
        <Label Foreground="AntiqueWhite" Content="Encrypted text" HorizontalAlignment="Left" Margin="474,20,0,0" VerticalAlignment="Top"/>
        <Button Background="LightBlue" x:Name="btnSave" Content="Save cipher to file" HorizontalAlignment="Left" Margin="529,389,0,0" VerticalAlignment="Top" Width="202" Click="btnSave_Click"/>
        <Border BorderBrush="AntiqueWhite" BorderThickness="2,2,2,2" Margin="482,80,31,77" CornerRadius="20,20,20,20"/>
    </Grid>
</Window>