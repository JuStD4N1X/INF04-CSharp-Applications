<Window x:Class="passport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:passport"
        mc:Ignorable="d"
        Title="Passport data entry. Made by: Daniel" Height="450" Width="1000" Background="CadetBlue">
    <Grid>
        <Label Content="Number" HorizontalAlignment="Left" Margin="60,40,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="numberTextBox" HorizontalAlignment="Left" Margin="150,40,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="227" Background="Azure" LostFocus="TextBox_LostFocus"/>

        <Label Content="First Name" HorizontalAlignment="Left" Margin="60,85,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="firstNameTextBox" HorizontalAlignment="Left" Margin="150,85,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="227" Background="Azure"/>

        <Label Content="Last Name" HorizontalAlignment="Left" Margin="60,130,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="lastNameTextBox" HorizontalAlignment="Left" Margin="150,130,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="227" Background="Azure"/>

        <GroupBox Header="Eye color" Margin="60,203,553,54">
            <Grid Margin="0,0,-2,0">
                <RadioButton x:Name="rBlue" Content="blue" HorizontalAlignment="Left" Margin="40,20,0,0" VerticalAlignment="Top" IsChecked="True" GroupName="rButtons"/>
                <RadioButton x:Name="rGreen" Content="green" HorizontalAlignment="Left" Margin="40,50,0,0" VerticalAlignment="Top" GroupName="rButtons"/>
                <RadioButton x:Name="rHazel" Content="hazel" HorizontalAlignment="Left" Margin="40,80,0,0" VerticalAlignment="Top" GroupName="rButtons"/>
            </Grid>
        </GroupBox>

        <Image x:Name="photoImage" Margin="500,30,305,178" Source="/Properties/000-zdjecie.jpg" Stretch="Fill" Height="200"/>
        <Image x:Name="fingerprintImage" Margin="762,53,38,201" Source="/Properties/000-odcisk.jpg" Stretch="Fill" Height="200"/>

        <Button Content="OK" HorizontalAlignment="Left" Margin="500,321,0,0" VerticalAlignment="Top" Width="473" Height="59" Background="Azure" Click="Button_Click"/>
    </Grid>
</Window>