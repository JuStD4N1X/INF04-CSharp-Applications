<Window x:Class="rgb.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:rgb"
        mc:Ignorable="d"
        Title="RGB Color Swatch. Made by Daniel" Height="450" Width="800" Background="Cornsilk" Loaded="Window_Loaded">
    <Grid>
        <Rectangle x:Name="bigRec" Fill="White" HorizontalAlignment="Left" Height="91" Margin="100,37,0,0" VerticalAlignment="Top" Width="600"/>
        <Label Content="Choose a color with the sliders and save with the button" HorizontalAlignment="Left" Margin="114,146,0,0" VerticalAlignment="Top"/>
        <Slider x:Name="sliderR" HorizontalAlignment="Left" Margin="158,193,0,0" VerticalAlignment="Top" Width="521" Minimum="0" Maximum="255" ValueChanged="slider_ValueChanged"/>
        <Slider x:Name="sliderG" HorizontalAlignment="Left" Margin="158,247,0,0" VerticalAlignment="Top" Width="521" Minimum="0" Maximum="255" ValueChanged="slider_ValueChanged"/>
        <Slider x:Name="sliderB" HorizontalAlignment="Left" Margin="158,301,0,0" VerticalAlignment="Top" Width="521" Minimum="0" Maximum="255" ValueChanged="slider_ValueChanged"/>
        <Label Content="R" HorizontalAlignment="Left" Margin="122,189,0,0" VerticalAlignment="Top"/>
        <Label Content="G" HorizontalAlignment="Left" Margin="121,243,0,0" VerticalAlignment="Top"/>
        <Label Content="B" HorizontalAlignment="Left" Margin="122,297,0,0" VerticalAlignment="Top"/>
        <Button x:Name="btnPick" Content="Pick" Background="Peru" HorizontalAlignment="Left" Margin="307,333,0,0" VerticalAlignment="Top" Width="224" Height="30" Click="btnPick_Click"/>
        <Rectangle x:Name="smallRec" Fill="White" HorizontalAlignment="Left" Height="47" Margin="307,377,0,0" VerticalAlignment="Top" Width="224"/>
        <Label x:Name="lblSmallRec" Content="255, 255, 255" HorizontalAlignment="Left" Margin="315,383,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblR" Content="255" HorizontalAlignment="Left" Margin="700,189,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblG" Content="255" HorizontalAlignment="Left" Margin="700,243,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblB" Content="255" HorizontalAlignment="Left" Margin="700,297,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>