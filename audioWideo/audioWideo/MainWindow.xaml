<Window x:Class="audioWideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multimedia Test INF.04" Height="450" Width="500" Background="#F0F0F0">
    <Grid>
        <StackPanel Margin="20" VerticalAlignment="Center">

            <TextBlock Text="VIDEO/AUDIO PLAYER" FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <Border BorderBrush="Black" BorderThickness="2" CornerRadius="5" Background="Black">
                <MediaElement Name="player" 
                              Source="Test.mp4" 
                              LoadedBehavior="Manual" 
                              Width="400" Height="220"/>
            </Border>

            <WrapPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="▶ PLAY" Click="BtnPlay_Click" Width="90" Height="35" Margin="5" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                <Button Content="⏸ PAUSE" Click="BtnPause_Click" Width="90" Height="35" Margin="5" Background="#FF9800" Foreground="White" FontWeight="Bold"/>
                <Button Content="⏹ STOP" Click="BtnStop_Click" Width="90" Height="35" Margin="5" Background="#F44336" Foreground="White" FontWeight="Bold"/>
            </WrapPanel>

            <TextBlock Text="*Make sure the test.mp4 (or test.mp3) file is in the bin/Debug folder!" 
                       Foreground="Gray" FontSize="11" HorizontalAlignment="Center" Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Window>